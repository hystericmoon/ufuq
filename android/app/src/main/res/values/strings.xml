    <string name="pair_title">Pair with your Mac</string>
    <string name="pair_intro">On your Mac, open Ufuq in the menu bar and choose Pair phone…. A QR code appears. Keep both devices on the same Wi-Fi.</string>
    <string name="pair_step_scan">Scan the QR code</string>
    <string name="pair_camera_why">Ufuq uses the camera only on this screen, to read the QR code. Nothing is recorded or saved.</string>

    <!-- Overlay permission explanation -->
    <string name="overlay_title">Show the island over other apps</string>
    <string name="overlay_what">The island is a small black pill at your camera that shows the next prayer, and opens into a card when you tap it.</string>
    <string name="overlay_why">To draw over other apps, Android asks for the permission “Display over other apps”. Ufuq uses it for the island and nothing else.</string>
    <string name="overlay_privacy">Ufuq does not read what is on your screen and has no internet access.</string>
    <string name="overlay_alternative">You can turn it off any time in Settings. The Live Update chip shows the same countdown without this permission, and is the best choice with a screen reader.</string>
    <string name="overlay_continue">Open Android settings</string>
    <string name="overlay_cancel">Not now</string>

